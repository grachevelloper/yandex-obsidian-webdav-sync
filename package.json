{
  "name": "yandex-disk-webdav-sync",
  "version": "1.0.5",
  "private": true,
  "license": "MIT",
  "description": "Manual two-way Obsidian sync over Yandex Disk WebDAV",
  "type": "module",
  "scripts": {
    "build": "tsc --noEmit && node esbuild.config.mjs && npm run test:bundle",
    "test": "node scripts/test.mjs",
    "check": "npm run format:check && npm run lint && npm test && npm run build",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint": "npm run lint:community && npm run lint:recommended",
    "lint:community": "node scripts/lint-community.mjs",
    "lint:recommended": "eslint . --max-warnings 0",
    "test:bundle": "node --test tests/runtime/plugin-load.test.mjs",
    "ui:capture": "tsc --noEmit && node tests/e2e/gallery/capture.mjs",
    "ui:gallery": "node tests/e2e/gallery/serve.mjs",
    "ui:e2e": "playwright test --config tests/e2e/playwright.config.mjs"
  },
  "dependencies": {
    "fast-xml-parser": "^5.3.0",
    "node-diff3": "3.2.1"
  },
  "devDependencies": {
    "@playwright/test": "1.56.1",
    "@types/jsdom": "^30.0.0",
    "@types/node": "^24.0.0",
    "esbuild": "^0.25.0",
    "eslint": "^9.39.5",
    "eslint-plugin-obsidianmd": "^0.5.1",
    "eslint-plugin-obsidianmd-community": "npm:eslint-plugin-obsidianmd@0.4.2",
    "jsdom": "^30.1.3",
    "obsidian": "^1.8.7",
    "prettier": "^3.9.10",
    "tsx": "^4.20.0",
    "typescript": "^5.9.0"
  },
  "overrides": {
    "@typescript-eslint/typescript-estree": {
      "minimatch": "^11.0.1"
    },
    "eslint-plugin-n": {
      "minimatch": "^11.0.1"
    },
    "eslint-plugin-json-schema-validator": {
      "minimatch": "^11.0.1"
    },
    "moment": "^2.31.0"
  }
}
