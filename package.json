{
  "name": "yandex-disk-webdav-sync",
  "version": "1.0.3",
  "private": true,
  "license": "MIT",
  "description": "Manual two-way Obsidian sync over Yandex Disk WebDAV",
  "type": "module",
  "scripts": {
    "build": "tsc --noEmit && node esbuild.config.mjs",
    "test": "node scripts/test.mjs",
    "check": "npm run format:check && npm run lint && npm test && npm run build",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint": "eslint . --max-warnings 0"
  },
  "dependencies": {
    "fast-xml-parser": "^5.3.0",
    "fast-xml-validator": "^1.4.2"
  },
  "devDependencies": {
    "@types/jsdom": "^30.0.0",
    "@types/node": "^24.0.0",
    "esbuild": "^0.25.0",
    "eslint": "^9.39.5",
    "eslint-plugin-obsidianmd": "^0.5.1",
    "jsdom": "^30.1.3",
    "obsidian": "^1.8.7",
    "prettier": "^3.9.10",
    "tsx": "^4.20.0",
    "typescript": "^5.9.0"
  },
  "overrides": {
    "@typescript-eslint/typescript-estree": {
      "minimatch": "^11.0.1"
    },
    "eslint-plugin-n": {
      "minimatch": "^11.0.1"
    }
  }
}
